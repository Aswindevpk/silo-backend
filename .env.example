# ==============================================================================
# Environment & Core Django Settings
# ==============================================================================
ENVIRONMENT=production                 # Options: development, staging, production
DEBUG=False                            # Must be False in Staging & Production
SECRET_KEY=your-super-secret-django-key
DJANGO_SETTINGS_MODULE=config.settings

# ==============================================================================
# Domains, CORS & CSRF (Comma-separated, no spaces)
# ==============================================================================
ALLOWED_HOSTS=app.yourdomain.com,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# ==============================================================================
# PostgreSQL Database
# ==============================================================================
DB_NAME=silo_db
DB_USER=silo_user
DB_PASSWORD=your_secure_db_password
DB_HOST=db                             # Service name in Docker Compose
DB_PORT=5432

# ==============================================================================
# Redis & Celery (Asynchronous Tasks & Channels Layer)
# ==============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==============================================================================
# Authentication & Third-Party Auth (Google OAuth2)
# ==============================================================================
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# Email Service (Resend)
# ==============================================================================
RESEND_API_KEY=re_your_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# ==============================================================================
# Cloudflare Real-Time Services (TURN & Calls / SFU)
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_TURN_KEY_ID=your_turn_key_id
CLOUDFLARE_TURN_API_TOKEN=your_turn_api_token
CLOUDFLARE_SFU_APP_ID=your_sfu_app_id
CLOUDFLARE_SFU_API_TOKEN=your_sfu_api_token

# ==============================================================================
# Media Storage (Cloudflare R2 - S3 Compatible)
# ==============================================================================
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
AWS_STORAGE_BUCKET_NAME=silo-prod-media
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com
AWS_S3_TOKEN=

# ==============================================================================
# Automated Database Backups (Cloudflare R2 / S3 Sidecar)
# ==============================================================================
BACKUP_S3_BUCKET=silo-prod-backups
BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_KEEP_DAYS=14

# ==============================================================================
# Deployment & Maintenance
# ==============================================================================
MAINTENANCE_FLAG=/var/www/html/silo-maintenance/.silo_maintenance
APP_PORT=8000
HEALTH_ENDPOINT=http://127.0.0.1:8000/health/
API_DOMAIN=api.yourdomain.com
